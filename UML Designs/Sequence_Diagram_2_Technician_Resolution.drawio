<mxfile host="app.diagrams.net" modified="2026-09-30T20:00:00.000Z" agent="Gemini" version="24.0.0" type="device"><diagram id="seq2_diag" name="Sequence Diagram 2 - Technician Triage &amp; Resolution"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="seq2_title" value="Sequence Diagram 2: Technician Triage, Assignment &amp;amp; Resolution&amp;#xa;System: FS-DSD IT Helpdesk | Actors &amp;amp; Components: Technician, ASP.NET Web App &amp;amp; Supabase" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#1A365D;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="900" height="50" as="geometry" /></mxCell><mxCell id="ll_tech_head" value="Technician&amp;#xa;[IT Support]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#1A365D;strokeColor=#1A365D;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="65" y="80" width="150" height="55" as="geometry" /></mxCell><mxCell id="ll_tech_line" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#A0AEC0;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="135" as="sourcePoint" /><mxPoint x="140" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_mvc_head" value="ASP.NET Web MVC&amp;#xa;[Dashboard UI]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#0D9488;strokeColor=#0D9488;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="80" width="150" height="55" as="geometry" /></mxCell><mxCell id="ll_mvc_line" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#A0AEC0;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="135" as="sourcePoint" /><mxPoint x="420" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_ctrl_head" value="TicketController&amp;#xa;[ASP.NET API]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#2B6CB0;strokeColor=#2B6CB0;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="635" y="80" width="150" height="55" as="geometry" /></mxCell><mxCell id="ll_ctrl_line" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#A0AEC0;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="135" as="sourcePoint" /><mxPoint x="710" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_db2_head" value="Supabase Database&amp;#xa;[PostgreSQL]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#4C51BF;strokeColor=#4C51BF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="925" y="80" width="150" height="55" as="geometry" /></mxCell><mxCell id="ll_db2_line" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#A0AEC0;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="135" as="sourcePoint" /><mxPoint x="1000" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="ll_staff2_head" value="Staff (Mobile)&amp;#xa;[End User]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#718096;strokeColor=#718096;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1205" y="80" width="150" height="55" as="geometry" /></mxCell><mxCell id="ll_staff2_line" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;strokeColor=#A0AEC0;strokeWidth=1.5;"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="135" as="sourcePoint" /><mxPoint x="1280" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_0" value="1: Navigate to 'View Open Tickets'" edge="1" parent="1" style="html=1;strokeColor=#2D3748;strokeWidth=1.6;fontColor=#2D3748;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=0;endFill=1;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="160" as="sourcePoint" /><mxPoint x="420" y="160" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_1" value="2: GET /Tickets/Open" edge="1" parent="1" style="html=1;strokeColor=#2B6CB0;strokeWidth=1.6;fontColor=#2B6CB0;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=0;endFill=1;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="210" as="sourcePoint" /><mxPoint x="710" y="210" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_2" value="3: SELECT * FROM tickets WHERE status='Open'" edge="1" parent="1" style="html=1;strokeColor=#4C51BF;strokeWidth=1.6;fontColor=#4C51BF;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=0;endFill=1;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="260" as="sourcePoint" /><mxPoint x="1000" y="260" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_3" value="4: Return Open Incident Records" edge="1" parent="1" style="html=1;strokeColor=#4C51BF;strokeWidth=1.6;fontColor=#4C51BF;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=1;endFill=0;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="310" as="sourcePoint" /><mxPoint x="710" y="310" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_4" value="5: Render ViewOpenTickets()" edge="1" parent="1" style="html=1;strokeColor=#2B6CB0;strokeWidth=1.6;fontColor=#2B6CB0;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=1;endFill=0;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="360" as="sourcePoint" /><mxPoint x="420" y="360" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_5" value="6: Display incident list to technician" edge="1" parent="1" style="html=1;strokeColor=#2D3748;strokeWidth=1.6;fontColor=#2D3748;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=1;endFill=0;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="410" as="sourcePoint" /><mxPoint x="140" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_6" value="7: Click 'Assign to Me' (Assign Ticket)" edge="1" parent="1" style="html=1;strokeColor=#1A365D;strokeWidth=1.6;fontColor=#1A365D;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=0;endFill=1;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="470" as="sourcePoint" /><mxPoint x="420" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_7" value="8: UPDATE tickets SET technician_id = @current_user" edge="1" parent="1" style="html=1;strokeColor=#4C51BF;strokeWidth=1.6;fontColor=#4C51BF;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=0;endFill=1;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="530" as="sourcePoint" /><mxPoint x="1000" y="530" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_8" value="9: 200 OK (Status marked as 'In Progress')" edge="1" parent="1" style="html=1;strokeColor=#2D3748;strokeWidth=1.6;fontColor=#2D3748;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=1;endFill=0;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="580" as="sourcePoint" /><mxPoint x="140" y="580" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_9" value="10: Enter Resolution Notes &amp; click 'Resolve Ticket'" edge="1" parent="1" style="html=1;strokeColor=#1A365D;strokeWidth=1.6;fontColor=#1A365D;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=0;endFill=1;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="640" as="sourcePoint" /><mxPoint x="420" y="640" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_10" value="11: UPDATE tickets SET status='Resolved', resolution_notes=@notes" edge="1" parent="1" style="html=1;strokeColor=#4C51BF;strokeWidth=1.6;fontColor=#4C51BF;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=0;endFill=1;endArrow=block;"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="700" as="sourcePoint" /><mxPoint x="1000" y="700" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_11" value="12: &lt;&lt;extend&gt;&gt; Realtime Push Notification (ticket resolved)" edge="1" parent="1" style="html=1;strokeColor=#D97706;strokeWidth=1.6;fontColor=#D97706;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=1;endFill=0;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="780" as="sourcePoint" /><mxPoint x="1280" y="780" as="targetPoint" /></mxGeometry></mxCell><mxCell id="step2_12" value="13: 200 OK (Ticket Resolved successfully)" edge="1" parent="1" style="html=1;strokeColor=#2D3748;strokeWidth=1.6;fontColor=#2D3748;fontStyle=1;fontSize=10;verticalAlign=bottom;align=center;dashed=1;endFill=0;endArrow=open;"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="840" as="sourcePoint" /><mxPoint x="140" y="840" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq2_note" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt; Save Status Change:&amp;#xa;Enforces mandatory notes &amp;amp; updated timestamp" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="715" width="290" height="55" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>